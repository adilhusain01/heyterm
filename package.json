{
  "name": "heyterm",
  "version": "0.1.10",
  "description": "Run your coding agents by voice: Claude Code, Codex and Gemini CLI in one window, with an assistant that hears you and speaks up when a session needs you.",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json",
    "dev": "node scripts/dev.mjs",
    "build": "vite build && esbuild src/server/cli.ts --bundle --platform=node --format=esm --packages=external --target=node20 --outfile=dist/server/cli.js",
    "start": "tsx src/server/serve.ts",
    "build:playground": "vite build --mode playground --outDir ../../dist/playground",
    "notices": "node scripts/notices.mjs",
    "prepublishOnly": "npm run build && npm test",
    "deploy:playground": "npm run build:playground && cd dist/playground && vercel deploy --prod --yes --project heyterm",
    "build:site": "node scripts/site-faces.mjs && vite build --config vite.site.config.ts && vite build --mode playground --base /playground/ --outDir ../../dist/site/playground",
    "dev:site": "node scripts/site-faces.mjs && vite --config vite.site.config.ts",
    "deploy:site": "npm run build:site && cd dist/site && vercel deploy --prod --yes --project heyterm"
  },
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.310",
    "@lydell/node-pty": "^1.2.0-beta.15",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/headless": "^6.0.0",
    "sirv": "^3.0.2",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@dicebear/core": "10.7.0",
    "@dicebear/styles": "10.6.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/martian-mono": "5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "sonner": "^2.0.8",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "zustand": "^5.0.16"
  },
  "allowScripts": {
    "node-pty@1.1.0": true,
    "esbuild@0.28.2": true
  },
  "bin": {
    "heyterm": "bin/heyterm.js"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "bin",
    "dist/server",
    "dist/web",
    "THIRD_PARTY_NOTICES.md",
    "SECURITY.md",
    "assets"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adilhusain01/heyterm.git"
  },
  "homepage": "https://github.com/adilhusain01/heyterm#readme",
  "bugs": {
    "url": "https://github.com/adilhusain01/heyterm/issues"
  },
  "author": "Adil Husain",
  "keywords": [
    "voice",
    "claude-code",
    "codex",
    "gemini-cli",
    "coding-agents",
    "terminal",
    "dictation",
    "wispr-flow"
  ]
}
