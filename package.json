{
  "name": "callsign-cli",
  "version": "0.1.0",
  "description": "Run your coding agents by voice: one window for all your Claude Code sessions, with a voice layer that routes what you say and tells you when a session needs you.",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json",
    "dev": "node scripts/dev.mjs",
    "build": "vite build && esbuild src/server/cli.ts --bundle --platform=node --format=esm --packages=external --target=node20 --outfile=dist/server/cli.js",
    "start": "tsx src/server/serve.ts",
    "build:playground": "vite build --mode playground --outDir ../../dist/playground"
  },
  "license": "UNLICENSED",
  "type": "module",
  "private": "true",
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.310",
    "@lydell/node-pty": "^1.2.0-beta.15",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/headless": "^6.0.0",
    "boring-avatars": "^2.0.4",
    "react-markdown": "^10.1.0",
    "sirv": "^3.0.2",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sonner": "^2.0.8",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "zustand": "^5.0.16"
  },
  "allowScripts": {
    "node-pty@1.1.0": true,
    "esbuild@0.28.2": true
  },
  "bin": {
    "callsign": "bin/callsign.js"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "bin",
    "dist"
  ]
}
